# Application
APP_ENV=development
LOG_LEVEL=INFO

# Moteur LLM — mettre 1 pour le moteur factice deterministe (tests, CI, demo hors ligne)
MARDIK_FAKE_LLM=1

# LLM (Azure AI Inference) — memes variables que le projet mARDIK
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=Kimi-K2.6
MARDIK_LLM_TIMEOUT_S=30

# OpenTelemetry — OTLP/gRPC (Jaeger all-in-one expose 4317)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mardik-contrats
OTEL_METRICS_EXPORTER=console
# Mettre 0 pour desactiver totalement l'export OTLP (tests, CI)
MARDIK_OTEL_ACTIF=1

# Repartition canary — part du trafic envoyee a la v2 (0 a 100)
MARDIK_CANARY_V2=0
